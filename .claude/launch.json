{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "nest-agent",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "agent",
        "start"
      ],
      "port": 8790,
      "autoPort": false
    },
    {
      "name": "nest-mock-agent",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app",
        "run",
        "dev:mock"
      ],
      "port": 8790
    },
    {
      "name": "nest-app",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app",
        "run",
        "dev"
      ],
      "port": 5173
    }
  ]
}