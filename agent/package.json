{
  "name": "nest-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Nest agent: keeps savings baskets on target on SoDEX testnet with a trade-only key",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "5.9",
    "wrangler": "^4.160.1"
  }
}
