# Only for `npm run test:live`. Never commit the real file.
# Seed phrase of YOUR whitelisted, funded SoDEX testnet wallet (testnet tokens only).
E2E_SEED=
# Root secret the agent derives its trade-only key from (64 hex chars). Keep it: the key registered on SoDEX is derived from it.
E2E_ROOT_SECRET=

# Turns the live spec on (npm run test:live loads this file)
E2E_LIVE=1
